# systemd unit for running the API server without Docker.
# Install with:  sudo deploy/install.sh   (see that script for the manual steps)
#
#   systemctl status|start|stop|restart apiserver
#   tail -f /var/log/apiserver/apiserver.log   # application logs (JSON lines)
#   journalctl -u apiserver -f                 # startup errors / crash tracebacks
[Unit]
Description=E-Commerce demo API server (FastAPI + Db2)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/apiserver
EnvironmentFile=/opt/apiserver/.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Application logs go to a file; LOG_FILE in the EnvironmentFile overrides this
Environment=LOG_FILE=/var/log/apiserver/apiserver.log
ExecStart=/opt/apiserver/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3
# uvicorn shuts down gracefully on SIGTERM; give in-flight requests and the Db2 pool time to close
KillSignal=SIGTERM
TimeoutStopSec=20

# systemd creates /var/log/apiserver owned by User= and makes it writable despite ProtectSystem
LogsDirectory=apiserver
LogsDirectoryMode=0750
# Anything printed before logging is set up (or an uncaught crash) still lands in journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apiserver

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The bundled Db2 clidriver (inside the venv) may write diagnostic files
ReadWritePaths=/opt/apiserver

[Install]
WantedBy=multi-user.target
